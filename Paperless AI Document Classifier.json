    {
      "parameters": {
        "jsCode": "// Build dictionaries ONCE from paginated API results\n// This runs BEFORE the loop starts\n\nconst aggregateResults = (nodeName) => {\n  const nodeItems = $(nodeName).all();\n  let allResults = [];\n  for (const item of nodeItems) {\n    if (item.json.results && Array.isArray(item.json.results)) {\n      allResults = allResults.concat(item.json.results);\n    }\n  }\n  return allResults;\n};\n\nconst tags = aggregateResults('Fetch Tags');\nconst correspondents = aggregateResults('Fetch Correspondents');\nconst documentTypes = aggregateResults('Fetch Document Types');\nconst aiTagData = $('Set AI Tag ID').first().json;\n\nconst toLowerCase = (s) => (s ?? '').toString().trim().toLowerCase();\n\nconst aiProcessedTagId = aiTagData.aiProcessedTagId;\n\n// Filter out ai-processed tag from the list shown to AI\nconst filteredTags = tags.filter(tag => tag.id !== aiProcessedTagId);\n\n// Tags: lowercase keys for matching\nconst tagMap = Object.fromEntries(\n  filteredTags.map(tag => [toLowerCase(tag.name), tag.id])\n);\n\n// Correspondents: case-insensitive lookup, preserve original name\nconst correspondentMap = Object.fromEntries(\n  correspondents.map(c => [toLowerCase(c.name), { id: c.id, name: c.name }])\n);\n\n// Document types: lowercase keys\nconst documentTypeMap = Object.fromEntries(\n  documentTypes.map(dt => [toLowerCase(dt.name), dt.id])\n);\n\nreturn [{\n  json: {\n    tagMap,\n    correspondentMap,\n    documentTypeMap,\n    aiProcessedTagId\n  }\n}];"
      },
      "id": "4ac66697-8838-4482-9f05-b47fafa55dd3",
      "name": "Build Dictionaries",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        3856,
        5088
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Merge current document with dictionaries built earlier\nconst docDetails = $json;\nconst dictionaries = $('Build Dictionaries').first().json;\n\nreturn {\n  json: {\n    document: docDetails,\n    ...dictionaries\n  }\n};"
      },
