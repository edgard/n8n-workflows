        4896
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Merge created document type ID back into patch body\n// Get data from Need Create Document Type? IF node, which has the full context\n// (either from Plan Updates directly, or from Merge Correspondent ID if correspondent was created)\nconst planData = $('Need Create Document Type?').first().json;\nconst dictionaries = $('Build Dictionaries').first().json;\nconst createdId = $json.id;\n\n// Fallback logic:\n// 1. Use created ID if successful\n// 2. Try to find existing document type by name (handles duplicate name errors)\n// 3. Fall back to original value (null if doesn't exist)\nconst existingId = dictionaries.documentTypeMap[planData.documentTypeName];\nconst documentTypeId = createdId ?? existingId ?? planData.patchBody.document_type;\n\nreturn {\n  json: {\n    ...planData,\n    patchBody: {\n      ...planData.patchBody,\n      document_type: documentTypeId\n    }\n  }\n};"
      },
