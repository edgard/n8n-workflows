    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const dictionaries = $('Build Dictionaries').first().json;\nconst documentDetails = $('Fetch Document Details').first().json;\n\nconst toLowerCase = (s) => {\n  if (s == null) return null;\n  const trimmed = s.toString().trim();\n  return trimmed.length > 0 ? trimmed.toLowerCase() : null;\n};\n\nlet aiOutput = $json.output ?? $json;\nif (typeof aiOutput === 'string') {\n  aiOutput = JSON.parse(aiOutput);\n}\n\nconst documentId = documentDetails.id;\n\n// Tags\nconst tagIds = (Array.isArray(aiOutput.tags) ? aiOutput.tags : [])\n  .map(tagName => dictionaries.tagMap[toLowerCase(tagName)])\n  .filter(id => typeof id === 'number');\ntagIds.push(dictionaries.aiProcessedTagId);\n\n// Correspondent\nconst correspondentRaw = aiOutput.correspondent;\nconst correspondentKey = toLowerCase(correspondentRaw);\nconst correspondentMatch = correspondentKey ? dictionaries.correspondentMap[correspondentKey] : null;\nconst correspondentId = correspondentMatch ? correspondentMatch.id : null;\nconst correspondentName = correspondentRaw?.trim() || null;\nconst needCreateCorrespondent = !!(correspondentName && !correspondentId);\n\n// Document type\nconst documentTypeRaw = aiOutput.document_type;\nconst documentTypeKey = toLowerCase(documentTypeRaw);\nconst documentTypeId = documentTypeKey ? dictionaries.documentTypeMap[documentTypeKey] : null;\nconst needCreateDocumentType = !!(documentTypeKey && !documentTypeId);\n\nconst patchBody = {\n  tags: tagIds,\n  correspondent: correspondentId,\n  document_type: documentTypeId\n};\n\nconst title = aiOutput.title?.trim() || null;\nconst date = aiOutput.date?.trim() || null;\nif (title) patchBody.title = title;\nif (date) patchBody.created_date = date;\n\nreturn {\n  json: {\n    id: documentId,\n    patchBody,\n    correspondentName,\n    correspondentKey,\n    documentTypeName: documentTypeKey,\n    needCreateCorrespondent,\n    needCreateDocumentType\n  }\n};"
      },
