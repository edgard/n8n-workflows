    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Merge created correspondent ID back into patch body\nconst planData = $('Plan Updates').first().json;\nconst dictionaries = $('Build Dictionaries').first().json;\nconst createdId = $json.id;\n\n// Fallback logic:\n// 1. Use created ID if successful\n// 2. Try to find existing correspondent by key (handles duplicate name errors)\n// 3. Fall back to original value (null if doesn't exist)\nconst existingId = dictionaries.correspondentMap[planData.correspondentKey]?.id;\nconst correspondentId = createdId ?? existingId ?? planData.patchBody.correspondent;\n\nreturn {\n  json: {\n    ...planData,\n    patchBody: {\n      ...planData.patchBody,\n      correspondent: correspondentId\n    }\n  }\n};"
      },
      "id": "f94545d3-b97e-42a4-9f72-06cf99821f5b",
      "name": "Merge Correspondent ID",
